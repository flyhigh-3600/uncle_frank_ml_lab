// structured.ufp — structures keep their labels, comparisons keep their shape.
// `x < x` below is deliberately commented out: ordering a string field is an
// error, while equality is fine.

procedure structured_demo(
    input  matrix<float>[2,2] a,
    input  matrix<float>[2,2] b,
    output bool verdict
) {
    let x = structured{ int index = 3, string label = "new llm", matrix_var = a };
    let same = x.matrix_var == b;              // matrix<bool>[2,2]

    // x.label < "z"                             // error: strings are not ordered
    // let bad = x < x;                          // error: label cannot be ordered

    if (same[0,0] and x.index < 4 and x.label == "new llm") {
        verdict = true;
    } else {
        verdict = false;
    }
    return verdict;
}
