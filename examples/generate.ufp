// generate.ufp — iteration is a do-until feedback loop, never a general loop.
// `.`  = current accumulator
// `..` = enclosing procedure's result
// Q7 is decided (D-008): inputs come from the left, outputs exit right.
// Q14 (`..` scope) is still open.

@T(0)
procedure generate(
    input  string prompt,
    input  Qwen_3_4b model,
    output list<int> tokens
) {
    let seed = tokenizer.encode(prompt);

    tokens = seed run(
        token_tools.(tokens, .) concat(tokens)
        until (condition(. == model.end_token or tokens.length > 1024))
    );

    return tokens;
}
